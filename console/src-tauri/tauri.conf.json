{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pricing Console",
  "version": "0.1.0",
  "identifier": "com.abdel.pricing-console",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run build:js",
    "beforeBuildCommand": "npm run build:js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pricing Console",
        "width": 1080,
        "height": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
